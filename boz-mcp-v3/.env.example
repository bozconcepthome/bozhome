# BOZ MCP V3 ortam değişkenleri — bu dosyayı .env olarak kopyalayın, izinleri 600 yapın.
# Gerçek değerleri ASLA depoya eklemeyin.
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# Proxy kimlik bilgisini enjekte ediyorsa 1 yapın (anahtar gönderilmez)
TRENDYOL_AUTH_INJECTED=0
TRENDYOL_BASE_URL=https://apigw.trendyol.com
TRENDYOL_INTEGRATOR_NAME=SelfIntegration

BOZ_DB_PATH=./data/boz_v3.sqlite3
BOZ_BACKUP_DIR=./backups
BOZ_LOG_LEVEL=INFO
BOZ_CONFIG_FILE=./config/thresholds.json

# HTTP sunucusu (ChatGPT connector)
BOZ_HTTP_HOST=127.0.0.1
BOZ_HTTP_PORT=8765
BOZ_HTTP_PATH=/mcp
# En az 32 karakter rastgele değer; boş bırakılırsa HTTP modu başlamaz (stdio hariç)
BOZ_MCP_TOKEN=
# Token'ı ChatGPT gibi başlık gönderemeyen istemciler için URL yolunda kabul et (/mcp/<token>)
BOZ_ALLOW_PATH_TOKEN=0
# Reverse proxy alan adı (DNS rebinding koruması için), virgülle ayrılmış
BOZ_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Bildirim kanalı — VARSAYILAN KAPALI (onay olmadan etkinleştirmeyin)
# Değerler: none | telegram | webhook
BOZ_NOTIFY_CHANNEL=none
BOZ_TELEGRAM_BOT_TOKEN=
BOZ_TELEGRAM_CHAT_ID=
BOZ_WEBHOOK_URL=
